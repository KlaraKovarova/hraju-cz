// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Sport {
  id          String          @id @default(cuid())
  slug        String          @unique // e.g. "tenis", "squash"
  name        String          // display name
  nameCs      String          // Czech name
  subdomain   String          @unique // legacy field, same as slug
  description String?
  icon        String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  facilities  FacilitySport[]
}

model Location {
  id         String     @id @default(cuid())
  city       String
  region     String? // e.g. "Praha", "Jihomoravský kraj"
  country    String     @default("CZ")
  lat        Float?
  lng        Float?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  facilities Facility[]

  @@unique([city, region])
  @@index([city])
  @@index([region])
}

model Facility {
  id            String            @id @default(cuid())
  name          String
  slug          String            @unique
  description   String?
  address       String
  postalCode    String?
  locationId    String
  location      Location          @relation(fields: [locationId], references: [id])
  lat           Float?
  lng           Float?
  googlePlaceId String?
  courtsLanes   Int? // number of courts/lanes/pools
  pricing       String? // markdown or plain text pricing info
  openingHours  Json? // structured opening hours per day
  website       String?
  isActive      Boolean           @default(true)
  isClaimed     Boolean           @default(false)
  isPremium              Boolean           @default(false)
  isPromo                Boolean           @default(false) // true = promotional premium, auto-replaceable by paid
  bookingUrl             String?
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  subscriptionStatus     String?           // active, canceled, past_due, etc.
  premiumExpiresAt       DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  sports        FacilitySport[]
  amenities     FacilityAmenity[]
  contacts      Contact[]
  images        FacilityImage[]
  editRequests  EditRequest[]
  ownerTokens   OwnerToken[]
  views         FacilityView[]
  reviews       Review[]
  visits        Visit[]
  userPhotos    UserPhoto[]
  averageRating Float?
  reviewCount   Int              @default(0)

  @@index([locationId])
  @@index([slug])
  @@index([isActive])
}

model FacilitySport {
  id         String   @id @default(cuid())
  facilityId String
  sportId    String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  sport      Sport    @relation(fields: [sportId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([facilityId, sportId])
  @@index([facilityId])
  @@index([sportId])
}

model Amenity {
  id         String            @id @default(cuid())
  slug       String            @unique // e.g. "parking", "showers", "cafe"
  name       String
  nameCs     String
  icon       String?
  facilities FacilityAmenity[]
}

model FacilityAmenity {
  id         String   @id @default(cuid())
  facilityId String
  amenityId  String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, amenityId])
  @@index([facilityId])
}

model Contact {
  id         String      @id @default(cuid())
  facilityId String
  facility   Facility    @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  type       ContactType
  value      String
  label      String? // e.g. "Recepce", "Rezervace"
  isPrimary  Boolean     @default(false)
  createdAt  DateTime    @default(now())

  @@index([facilityId])
}

model FacilityImage {
  id         String   @id @default(cuid())
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  url        String
  alt        String?
  isPrimary  Boolean  @default(false)
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([facilityId])
}

enum ContactType {
  PHONE
  EMAIL
  WEBSITE
  FACEBOOK
  INSTAGRAM
}

model EditRequest {
  id             String            @id @default(cuid())
  facilityId     String
  facility       Facility          @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  submitterName  String
  submitterEmail String
  submitterPhone String?
  isOwner        Boolean           @default(false)
  changes        Json
  message        String?           @db.Text
  status         EditRequestStatus @default(PENDING)
  reviewedAt     DateTime?
  reviewNote     String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([facilityId])
  @@index([status])
}

enum EditRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model OwnerToken {
  id         String    @id @default(cuid())
  facilityId String
  facility   Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  token      String    @unique
  ownerEmail String?
  ownerName  String?
  usedAt     DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([facilityId])
  @@index([token])
}

model FacilityView {
  id                String   @id @default(cuid())
  facilityId        String
  facility          Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  date              DateTime @db.Date
  views             Int      @default(0)
  searchImpressions Int      @default(0)
  createdAt         DateTime @default(now())

  @@unique([facilityId, date])
  @@index([facilityId])
  @@index([date])
}

model Review {
  id                String    @id @default(cuid())
  facilityId        String
  facility          Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  userId            String?
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName        String
  authorEmail       String
  rating            Int       // 1-5
  title             String?
  text              String?   @db.Text
  helpful           Int       @default(0)
  flagged           Boolean   @default(false)
  isApproved        Boolean   @default(false)
  ownerNotifiedAt   DateTime? // when facility owner was emailed about this review
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  photos            UserPhoto[]

  @@index([facilityId])
  @@index([isApproved])
  @@index([userId])
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String?
  passwordHash       String?
  isSeed             Boolean  @default(false)
  emailNotifications Boolean  @default(true)
  weeklyDigest       Boolean  @default(true)
  unsubscribeToken   String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  reviews            Review[]
  visits             Visit[]
  userPhotos         UserPhoto[]
  loginTokens        LoginToken[]
  events             TouristEvent[]
}

model Visit {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  note       String?  @db.VarChar(280)
  createdAt  DateTime @default(now())
  photos     UserPhoto[]

  @@unique([userId, facilityId])
  @@index([facilityId])
  @@index([userId])
}

model LoginToken {
  id        String    @id @default(cuid())
  token     String    @unique
  email     String
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([email])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model TouristEvent {
  id          String   @id @default(cuid())
  sourceId    String   @unique
  name        String
  dateStart   DateTime
  dateEnd     DateTime?
  city        String
  region      String?
  description String?  @db.Text
  externalUrl String?
  lat         Float?
  lng         Float?
  source      String   @default("kct")
  isActive    Boolean  @default(true)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([city])
  @@index([region])
  @@index([dateStart])
  @@index([source])
  @@index([userId])
}

model UserPhoto {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  reviewId   String?
  review     Review?  @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  visitId    String?
  visit      Visit?   @relation(fields: [visitId], references: [id], onDelete: SetNull)
  url        String
  alt        String?
  isHidden   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([facilityId])
  @@index([reviewId])
  @@index([visitId])
  @@index([userId])
}
