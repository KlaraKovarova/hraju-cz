# PostgreSQL connection string (Neon or any standard postgres provider)
# For Neon: use the pooled connection string for the app, DIRECT_URL for migrations
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Direct (non-pooled) URL for Prisma migrations — only needed when running `prisma migrate`
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# SSH access for DB operations on Hostinger
# Use: npm run db:export / npm run db:import
# SSH key: ~/.ssh/id_ed25519_hrajucz
SSH_HOST="replikant996.thinline.cz"
SSH_USER="hraju_cz"
SSH_PORT="2741"

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Admin authentication
ADMIN_PASSWORD="changeme"
# All JWT secrets below are REQUIRED — app throws at runtime if missing.
# Generate strong random values, e.g. `openssl rand -hex 32`.
ADMIN_JWT_SECRET="changeme-generate-a-random-secret"
USER_JWT_SECRET="changeme-generate-a-random-secret"
OWNER_JWT_SECRET="changeme-generate-a-random-secret"

# Stripe (create products/prices in Stripe Dashboard first)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_MONTHLY="price_..."
STRIPE_PRICE_YEARLY="price_..."

# Cron job protection secret (used by GitHub Actions to call /api/cron/* endpoints)
CRON_SECRET="changeme-generate-a-random-secret"

# football-data.org API key — used by /api/cron/wc2026-results to fetch WC 2026 results.
# Free tier at https://www.football-data.org/client/register
# Leave empty to skip the external fetch (standings won't auto-update).
FOOTBALL_DATA_API_KEY=""

# Nodemailer / email (for digest emails and notifications)
EMAIL_HOST="smtp.example.com"
EMAIL_PORT="587"
EMAIL_USER="noreply@hraju.cz"
EMAIL_PASS="changeme"
EMAIL_FROM="hraju.cz <noreply@hraju.cz>"
