// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Sport {
  id          String          @id @default(cuid())
  slug        String          @unique // e.g. "tenis", "squash"
  name        String          // display name
  nameCs      String          // Czech name
  subdomain   String          @unique // legacy field, same as slug
  description String?
  icon        String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  facilities  FacilitySport[]
}

model Location {
  id         String     @id @default(cuid())
  city       String
  region     String? // e.g. "Praha", "Jihomoravský kraj"
  country    String     @default("CZ")
  lat        Float?
  lng        Float?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  facilities Facility[]

  @@unique([city, region])
  @@index([city])
  @@index([region])
}

model Facility {
  id            String            @id @default(cuid())
  name          String
  slug          String            @unique
  description   String?
  address       String
  postalCode    String?
  locationId    String
  location      Location          @relation(fields: [locationId], references: [id])
  lat           Float?
  lng           Float?
  googlePlaceId String?
  courtsLanes   Int? // number of courts/lanes/pools
  pricing       String? // markdown or plain text pricing info
  openingHours  Json? // structured opening hours per day
  website       String?
  isActive      Boolean           @default(true)
  isClaimed     Boolean           @default(false)
  isPremium              Boolean           @default(false)
  isPromo                Boolean           @default(false) // true = promotional premium, auto-replaceable by paid
  bookingUrl             String?
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  subscriptionStatus     String?           // active, canceled, past_due, etc.
  premiumExpiresAt       DateTime?
  isApproved             Boolean           @default(false) // admin has reviewed this listing
  approvedAt             DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  sports        FacilitySport[]
  amenities     FacilityAmenity[]
  contacts      Contact[]
  images        FacilityImage[]
  editRequests  EditRequest[]
  ownerTokens   OwnerToken[]
  views         FacilityView[]
  reviews       Review[]
  visits        Visit[]
  userPhotos    UserPhoto[]
  tips          FacilityTip[]
  favorites     Favorite[]
  favoriteNotifications FavoriteNotification[]
  premiumOrders PremiumOrder[]
  averageRating Float?
  reviewCount   Int              @default(0)
  tipCount      Int              @default(0)
  favoriteCount Int              @default(0)

  @@index([locationId])
  @@index([slug])
  @@index([isActive])
  @@index([isApproved])
}

model FacilitySport {
  id         String   @id @default(cuid())
  facilityId String
  sportId    String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  sport      Sport    @relation(fields: [sportId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([facilityId, sportId])
  @@index([facilityId])
  @@index([sportId])
}

model Amenity {
  id         String            @id @default(cuid())
  slug       String            @unique // e.g. "parking", "showers", "cafe"
  name       String
  nameCs     String
  icon       String?
  facilities FacilityAmenity[]
}

model FacilityAmenity {
  id         String   @id @default(cuid())
  facilityId String
  amenityId  String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, amenityId])
  @@index([facilityId])
}

model Contact {
  id         String      @id @default(cuid())
  facilityId String
  facility   Facility    @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  type       ContactType
  value      String
  label      String? // e.g. "Recepce", "Rezervace"
  isPrimary  Boolean     @default(false)
  createdAt  DateTime    @default(now())

  @@index([facilityId])
}

model FacilityImage {
  id         String   @id @default(cuid())
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  url        String
  alt        String?
  isPrimary  Boolean  @default(false)
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([facilityId])
}

enum ContactType {
  PHONE
  EMAIL
  WEBSITE
  FACEBOOK
  INSTAGRAM
}

model EditRequest {
  id             String            @id @default(cuid())
  facilityId     String
  facility       Facility          @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  submitterName  String
  submitterEmail String
  submitterPhone String?
  isOwner        Boolean           @default(false)
  changes        Json
  message        String?           @db.Text
  status         EditRequestStatus @default(PENDING)
  reviewedAt     DateTime?
  reviewNote     String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([facilityId])
  @@index([status])
}

enum EditRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model OwnerToken {
  id         String    @id @default(cuid())
  facilityId String
  facility   Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  token      String    @unique
  ownerEmail String?
  ownerName  String?
  usedAt     DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([facilityId])
  @@index([token])
}

model FacilityView {
  id                String   @id @default(cuid())
  facilityId        String
  facility          Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  date              DateTime @db.Date
  views             Int      @default(0)
  searchImpressions Int      @default(0)
  createdAt         DateTime @default(now())

  @@unique([facilityId, date])
  @@index([facilityId])
  @@index([date])
}

model Review {
  id                String    @id @default(cuid())
  facilityId        String
  facility          Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  userId            String?
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName        String
  authorEmail       String
  rating            Int       // 1-5
  title             String?
  text              String?   @db.Text
  helpful           Int       @default(0)
  flagged           Boolean   @default(false)
  isApproved        Boolean   @default(false)
  ownerNotifiedAt   DateTime? // when facility owner was emailed about this review
  replyCount        Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  photos            UserPhoto[]
  replies           ReviewReply[]

  @@index([facilityId])
  @@index([isApproved])
  @@index([userId])
}

model ReviewReply {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String   @db.Text
  flagged   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([reviewId])
  @@index([userId])
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String?
  passwordHash       String?
  bio                String?  @db.VarChar(200)
  location           String?  @db.VarChar(100)
  favoriteSports     String[] @default([])
  isSeed             Boolean  @default(false)
  emailNotifications Boolean  @default(true)
  weeklyDigest       Boolean  @default(true)
  unsubscribeToken   String?  @unique
  lastBadgeNudgeAt   DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  reviews            Review[]
  reviewReplies      ReviewReply[]
  visits             Visit[]
  userPhotos         UserPhoto[]
  loginTokens        LoginToken[]
  events             TouristEvent[]
  badges             UserBadge[]
  tips               FacilityTip[]
  favorites          Favorite[]
  favoriteNotifications FavoriteNotification[]
  notifications         Notification[]
}

model Visit {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  facilityId            String
  facility              Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  note                  String?   @db.VarChar(280)
  createdAt             DateTime  @default(now())
  reviewReminderSentAt  DateTime?
  photos                UserPhoto[]

  @@unique([userId, facilityId])
  @@index([facilityId])
  @@index([userId])
}

model LoginToken {
  id        String    @id @default(cuid())
  token     String    @unique
  email     String
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([email])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model TouristEvent {
  id          String   @id @default(cuid())
  sourceId    String   @unique
  name        String
  dateStart   DateTime
  dateEnd     DateTime?
  city        String
  region      String?
  description String?  @db.Text
  externalUrl String?
  lat         Float?
  lng         Float?
  source      String   @default("kct")
  isActive    Boolean  @default(true)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([city])
  @@index([region])
  @@index([dateStart])
  @@index([source])
  @@index([userId])
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeSlug String   // references badge definition in config
  earnedAt  DateTime @default(now())

  @@unique([userId, badgeSlug])
  @@index([userId])
}

model UserPhoto {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  reviewId   String?
  review     Review?  @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  visitId    String?
  visit      Visit?   @relation(fields: [visitId], references: [id], onDelete: SetNull)
  url        String
  alt        String?
  isHidden   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([facilityId])
  @@index([reviewId])
  @@index([visitId])
  @@index([userId])
}

model FacilityTip {
  id         String   @id @default(cuid())
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text       String   @db.VarChar(280)
  helpful    Int      @default(0)
  flagged    Boolean  @default(false)
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([facilityId])
  @@index([userId])
  @@index([isApproved])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, facilityId])
  @@index([facilityId])
  @@index([userId])
}

model FavoriteNotification {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  type       String   // "review" | "checkin"
  actorName  String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId, isRead])
  @@index([facilityId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "review_reply" | "badge_earned" | "challenge_completed"
  title     String
  body      String?
  linkUrl   String?
  icon      String?  // emoji
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

model Banner {
  id          String    @id @default(cuid())
  name        String
  imageUrl    String
  targetUrl   String
  placement   String[]
  sportFilter String[]
  isActive    Boolean   @default(true)
  startDate   DateTime?
  endDate     DateTime?
  impressions Int       @default(0)
  clicks      Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive])
}

model PremiumOrder {
  id              String    @id @default(cuid())
  facilityId      String
  facility        Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  variableSymbol  String    @unique // numeric string for bank transfer matching
  amount          Int       // amount in CZK (e.g. 1209)
  status          String    @default("pending") // pending, confirmed, cancelled
  adminNote       String?
  confirmedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([facilityId])
  @@index([status])
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  brand       String
  sport       String   // sport slug e.g. "ferraty", "lezeni"
  category    String   // product category e.g. "tlumic-padu", "set", "prilba", "rukavice"
  description String
  specs       Json?    // { weight, certifications, sizes, materials, etc. }
  images      String[] // array of image URLs
  sourceUrl   String   // link to manufacturer product page
  price       Int?     // price in CZK haléře (cents), null if unknown
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sport])
  @@index([brand])
}
